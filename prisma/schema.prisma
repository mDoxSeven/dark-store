generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model DigitalStore {
  guildId             String    @id
  channelsJson        String    @default("{}")
  paymentInstructions String    @default("Aguarde as instruções da equipe antes de realizar qualquer pagamento.")
  pixEnabled          Boolean   @default(false)
  pixKey              String?
  pixMerchantName     String?
  pixMerchantCity     String?
  salesChannelId      String?
  ordersChannelId     String?
  spotifyChannelId    String?
  spotifyMessageId    String?
  spotifyPublishUntil DateTime?
  supportRoleId       String?
  setupUntil          DateTime?
}

model DigitalProduct {
  id           String           @id @default(cuid())
  guildId      String
  title        String
  description  String           @default("")
  category     String           @default("Geral")
  priceCents   Int
  imageUrl     String           @default("")
  footer       String           @default("dark store")
  buttonLabel  String           @default("Comprar")
  accentColor  String           @default("#aeb1b6")
  divider      Boolean          @default(true)
  active       Boolean          @default(false)
  channelId    String?
  messageId    String?
  publishUntil DateTime?
  updatedAt    DateTime         @updatedAt
  stock        DigitalStock[]
  orders       DigitalOrder[]
  tickets      CheckoutTicket[]

  @@index([guildId])
}

model CheckoutTicket {
  id           String         @id @default(cuid())
  guildId      String
  userId       String
  productId    String
  productTitle String
  priceCents   Int
  channelId    String         @unique
  activeKey    String?        @unique
  status       String         @default("awaiting_confirmation")
  orderId      String?        @unique
  deleteAt     DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  product      DigitalProduct @relation(fields: [productId], references: [id])

  @@index([guildId, userId, status])
  @@index([deleteAt])
}

model DigitalStock {
  id          String         @id @default(cuid())
  productId   String
  ciphertext  String
  fingerprint String
  claimedAt   DateTime?
  createdAt   DateTime       @default(now())
  product     DigitalProduct @relation(fields: [productId], references: [id])
  order       DigitalOrder?

  @@unique([productId, fingerprint])
  @@index([productId, claimedAt])
}

model DigitalOrder {
  id                String         @id @default(cuid())
  guildId           String
  productId         String
  userId            String
  interactionId     String         @unique
  activeKey         String?        @unique
  productTitle      String
  priceCents        Int
  pixPayload        String?
  pixTxId           String?
  status            String         @default("pending")
  stockId           String?        @unique
  deliveryMessageId String?
  salesMessageId    String?
  approvedBy        String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  product           DigitalProduct @relation(fields: [productId], references: [id])
  stock             DigitalStock?  @relation(fields: [stockId], references: [id])

  @@index([guildId, status])
}

model WebSession {
  hash      String   @id
  expires   DateTime
  createdAt DateTime @default(now())
}

model LocalMessage {
  id        String @id
  channelId String
  body      String
}

model ManagedV2Panel {
  id            String            @id @default(cuid())
  guildId       String
  name          String
  channelId     String?
  messageId     String?           @unique
  title         String?
  description   String?
  color         String            @default("#aeb1b6")
  imageUrl      String?
  assetId       String?
  thumbnailUrl  String?
  footer        String?
  imagePosition String            @default("bottom")
  showDivider   Boolean           @default(true)
  spacing       String            @default("small")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  buttons       ManagedV2Button[]

  @@index([guildId])
}

model ManagedV2Button {
  id       String         @id @default(cuid())
  panelId  String
  label    String
  type     String         @default("LINK")
  url      String?
  roleId   String?
  roleMode String         @default("ADD")
  style    String         @default("SECONDARY")
  emoji    String?
  position Int            @default(0)
  panel    ManagedV2Panel @relation(fields: [panelId], references: [id], onDelete: Cascade)

  @@index([panelId, position])
}

model MediaAsset {
  id        String   @id @default(cuid())
  filename  String
  mime      String
  size      Int
  createdAt DateTime @default(now())
}

model AntiRaidConfig {
  guildId                  String   @id
  enabled                  Boolean  @default(false)
  joinLimit                Int      @default(8)
  joinWindowSeconds        Int      @default(10)
  minAccountAgeHours       Int      @default(24)
  destructiveLimit         Int      @default(3)
  destructiveWindowSeconds Int      @default(15)
  action                   String   @default("QUARANTINE")
  quarantineRoleId         String?
  logChannelId             String?
  trustedUserIds           String   @default("[]")
  updatedAt                DateTime @updatedAt
}

model SecurityIncident {
  id        String   @id @default(cuid())
  guildId   String
  kind      String
  actorId   String?
  targetId  String?
  action    String
  status    String
  details   String
  createdAt DateTime @default(now())

  @@index([guildId, createdAt])
}
