generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model DigitalStore {
  guildId                  String    @id
  channelsJson             String    @default("{}")
  paymentInstructions      String    @default("Aguarde as instruções da equipe antes de realizar qualquer pagamento.")
  pixEnabled               Boolean   @default(false)
  pixKey                   String?
  pixMerchantName          String?
  pixMerchantCity          String?
  salesChannelId           String?
  ordersChannelId          String?
  spotifyChannelId         String?
  spotifyMessageId         String?
  spotifyPublishUntil      DateTime?
  discordChannelId         String?
  discordMessageId         String?
  discordPublishUntil      DateTime?
  nitroChannelId           String?
  nitroMessageId           String?
  nitroPublishUntil        DateTime?
  verificationChannelId    String?
  verificationMessageId    String?
  verificationPublishUntil DateTime?
  supportRoleId            String?
  supportRoleIds           String    @default("[]")
  setupUntil               DateTime?
}

model DigitalProduct {
  id           String           @id @default(cuid())
  guildId      String
  title        String
  description  String           @default("")
  category     String           @default("Geral")
  priceCents   Int
  imageUrl     String           @default("")
  footer       String           @default("dark store")
  buttonLabel  String           @default("Comprar")
  accentColor  String           @default("#aeb1b6")
  divider      Boolean          @default(true)
  active       Boolean          @default(false)
  manualStock  Int              @default(0)
  channelId    String?
  messageId    String?
  publishUntil DateTime?
  updatedAt    DateTime         @updatedAt
  stock        DigitalStock[]
  orders       DigitalOrder[]
  tickets      CheckoutTicket[]

  @@index([guildId])
}

model CheckoutTicket {
  id           String         @id @default(cuid())
  guildId      String
  userId       String
  productId    String
  productTitle String
  priceCents   Int
  channelId    String         @unique
  activeKey    String?        @unique
  status       String         @default("awaiting_confirmation")
  orderId      String?        @unique
  deleteAt     DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  product      DigitalProduct @relation(fields: [productId], references: [id])

  @@index([guildId, userId, status])
  @@index([deleteAt])
}

model DigitalStock {
  id          String         @id @default(cuid())
  productId   String
  ciphertext  String
  fingerprint String
  claimedAt   DateTime?
  createdAt   DateTime       @default(now())
  product     DigitalProduct @relation(fields: [productId], references: [id])
  order       DigitalOrder?

  @@unique([productId, fingerprint])
  @@index([productId, claimedAt])
}

model DigitalOrder {
  id                String         @id @default(cuid())
  guildId           String
  productId         String
  userId            String
  interactionId     String         @unique
  activeKey         String?        @unique
  productTitle      String
  priceCents        Int
  pixPayload        String?
  pixTxId           String?
  status            String         @default("pending")
  stockId           String?        @unique
  deliveryMessageId String?
  salesMessageId    String?
  approvedBy        String?
  cancelledBy       String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  product           DigitalProduct @relation(fields: [productId], references: [id])
  stock             DigitalStock?  @relation(fields: [stockId], references: [id])

  @@index([guildId, status])
}

model WebSession {
  hash      String   @id
  expires   DateTime
  createdAt DateTime @default(now())
}

model LocalMessage {
  id        String @id
  channelId String
  body      String
}

model ManagedV2Panel {
  id            String            @id @default(cuid())
  guildId       String
  name          String
  channelId     String?
  messageId     String?           @unique
  title         String?
  description   String?
  color         String            @default("#aeb1b6")
  imageUrl      String?
  assetId       String?
  thumbnailUrl  String?
  footer        String?
  imagePosition String            @default("bottom")
  showDivider   Boolean           @default(true)
  spacing       String            @default("small")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  buttons       ManagedV2Button[]

  @@index([guildId])
}

model ManagedV2Button {
  id       String         @id @default(cuid())
  panelId  String
  label    String
  type     String         @default("LINK")
  url      String?
  roleId   String?
  roleMode String         @default("ADD")
  style    String         @default("SECONDARY")
  emoji    String?
  position Int            @default(0)
  panel    ManagedV2Panel @relation(fields: [panelId], references: [id], onDelete: Cascade)

  @@index([panelId, position])
}

model MediaAsset {
  id        String   @id @default(cuid())
  filename  String
  mime      String
  size      Int
  createdAt DateTime @default(now())
}

model AntiRaidConfig {
  guildId                  String   @id
  enabled                  Boolean  @default(false)
  joinLimit                Int      @default(8)
  joinWindowSeconds        Int      @default(10)
  minAccountAgeHours       Int      @default(24)
  destructiveLimit         Int      @default(3)
  destructiveWindowSeconds Int      @default(15)
  action                   String   @default("QUARANTINE")
  quarantineRoleId         String?
  logChannelId             String?
  trustedUserIds           String   @default("[]")
  updatedAt                DateTime @updatedAt
}

model SecurityIncident {
  id        String   @id @default(cuid())
  guildId   String
  kind      String
  actorId   String?
  targetId  String?
  action    String
  status    String
  details   String
  createdAt DateTime @default(now())

  @@index([guildId, createdAt])
}

model VortexSupportConfig {
  guildId          String                @id
  supportRoleId    String?
  publicCategoryId String?
  ticketCategoryId String?
  panelChannelId   String?
  staffChannelId   String?
  panelMessageId   String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  tickets          VortexSupportTicket[]
}

model VortexSupportTicket {
  id              String              @id @default(cuid())
  guildId         String
  userId          String
  category        String
  status          String              @default("OPEN")
  activeKey       String?             @unique
  channelId       String?             @unique
  ticketMessageId String?
  staffMessageId  String?
  claimedBy       String?
  claimedAt       DateTime?
  notifiedAt      DateTime?
  closedBy        String?
  closedAt        DateTime?
  deleteAt        DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  config          VortexSupportConfig @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@index([guildId, status, createdAt])
  @@index([guildId, userId, status])
  @@index([deleteAt])
}

model PasstimeConfig {
  guildId              String                  @id
  ownerId              String
  logsChannelId        String?
  memberRoleId         String?
  correctorRoleId      String?
  decoratorRoleId      String?
  managementRoleId     String?
  bankCategoryId       String?
  archiveCategoryId    String?
  requestChannelId     String?
  verificationChannelId String?
  identificationChannelId String?
  pointsChannelId      String?
  teamChannelId        String?
  scheduleChannelId    String?
  requestMessageId     String?
  verificationMessageId String?
  identificationMessageId String?
  pointsMessageId      String?
  teamMessageId        String?
  scheduleMessageId    String?
  requestBannerUrl     String?
  identificationBannerUrl String?
  pointsBannerUrl      String?
  teamBannerUrl        String?
  leaderId             String?
  deputyLeaderId       String?
  managerId            String?
  supervisorId         String?
  nickname             String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  banks                PasstimeBank[]
  scheduleEntries      PasstimeScheduleEntry[]
  reminders            PasstimeReminder[]
}

model PasstimeBank {
  id        String         @id @default(cuid())
  guildId   String
  userId    String
  channelId String?        @unique
  name      String
  emoji     String
  status    String         @default("ACTIVE")
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  config    PasstimeConfig @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@unique([guildId, userId])
  @@index([guildId, status])
}

model PasstimeScheduleEntry {
  id        String         @id @default(cuid())
  guildId   String
  day       String
  time      String
  label     String
  userId    String?
  activityKey String?
  reminderMinutes Int      @default(120)
  lastReminderKey String?
  lastStartKey String?
  position  Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  config    PasstimeConfig @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@index([guildId, day, time])
}

model PasstimeReminder {
  id           String         @id @default(cuid())
  guildId      String
  channelId    String
  time         String
  message      String
  enabled      Boolean        @default(true)
  lastSentDate String?
  createdBy    String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  config       PasstimeConfig @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@index([guildId, enabled, time])
}

model LeadershipConfig {
  guildId                 String   @id
  verifiedRoleId          String
  adminRoleIdsJson        String
  verificationChannelId   String?
  explanationChannelId    String?
  scheduleChannelId       String?
  rppChannelId            String?
  justificationChannelId  String?
  suggestionsChannelId    String?
  botChannelId            String?
  evaluationChannelId     String?
  reportsChannelId        String?
  upsChannelId            String?
  highlightsChannelId     String?
  reviewChannelId         String?
  verificationMessageId   String?
  explanationMessageId    String?
  scheduleMessageId       String?
  rppMessageId            String?
  justificationMessageId  String?
  suggestionsMessageId    String?
  botMessageId            String?
  evaluationMessageId     String?
  reportsMessageId        String?
  upsMessageId            String?
  highlightsMessageId     String?
  verificationBannerUrl   String?
  explanationBannerUrl    String?
  rppBannerUrl            String?
  justificationBannerUrl  String?
  suggestionsBannerUrl    String?
  stripBannerUrl          String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  requests                LeadershipRequest[]
  areas                   LeadershipArea[]
  scheduleEntries         LeadershipScheduleEntry[]
}

model LeadershipRequest {
  id              String   @id @default(cuid())
  guildId         String
  userId          String
  type            String
  fieldsJson      String
  status          String   @default("PENDING")
  reviewChannelId String?
  reviewMessageId String?
  reviewerId      String?
  createdAt       DateTime @default(now())
  resolvedAt      DateTime?
  config          LeadershipConfig @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@index([guildId, status, createdAt])
  @@index([guildId, userId, type, status])
}

model LeadershipArea {
  id              String   @id @default(cuid())
  guildId         String
  name            String
  roleId          String
  reportChannelId String?  @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  config          LeadershipConfig @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@unique([guildId, roleId])
  @@index([guildId, name])
}

model LeadershipScheduleEntry {
  id        String   @id @default(cuid())
  guildId   String
  day       String
  time      String
  label     String
  roleId    String?
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  config    LeadershipConfig @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@index([guildId, day, time])
}

model AltaRecruitmentConfig {
  guildId               String            @id
  announcementChannelId String?
  announcementMessageId String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  recruitments          AltaRecruitment[]
}

model AltaRecruitment {
  id               String                @id @default(cuid())
  guildId          String
  recruiterId      String
  targetId         String
  rankRoleId       String
  rankName         String
  cameFromFamily   Boolean               @default(false)
  previousFamily   String?
  staffInterest    Boolean?
  staffAreasJson   String                @default("[]")
  status           String                @default("PENDING")
  active           Boolean               @default(true)
  recordsChannelId String
  recordsMessageId String?               @unique
  reviewedBy       String?
  reviewedAt       DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  config           AltaRecruitmentConfig @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@index([guildId, recruiterId, status, active])
  @@index([guildId, targetId, active])
  @@index([guildId, status, createdAt])
}

model AltaSuggestionConfig {
  guildId String @id
  reviewChannelId String?
  panelMessageId String?
}

model AltaSuggestionDraft {
  userId String @id
  category String
  expiresAt DateTime
}

model AltaSuggestion {
  id String @id @default(cuid())
  authorId String
  category String
  body String
  sourceMessageId String @unique
  reviewMessageId String? @unique
  publicMessageId String? @unique
  status String @default("PENDING")
  reviewerId String?
  createdAt DateTime @default(now())
  @@index([status])
}

model SpotifyOAuthState {
  stateHash     String   @id
  discordUserId String
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  @@index([discordUserId])
  @@index([expiresAt])
}

model SpotifyConnection {
  discordUserId   String   @id
  accessTokenEnc  String
  refreshTokenEnc String
  accessExpiresAt DateTime
  scope           String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AltaMovChatConfig {
  guildId               String   @id
  managerRoleId         String?
  reportGuildId         String   @default("1542871650473746454")
  reportChannelId       String   @default("1554586776939794532")
  pointsCooldownSeconds Int      @default(10)
  cycleStartedAt        DateTime @default(now())
  lastReportAt          DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model AltaMovChatChannel {
  id               String   @id @default(cuid())
  guildId          String
  channelId        String
  pointsPerMessage Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([guildId, channelId])
  @@index([guildId])
}

model AltaMovChatStat {
  id                   String   @id @default(cuid())
  guildId              String
  userId               String
  messageCount         Int      @default(0)
  scoredMessageCount   Int      @default(0)
  chatPoints           Int      @default(0)
  manualPoints         Int      @default(0)
  lastScoredAt         DateTime?
  updatedAt            DateTime @updatedAt

  @@unique([guildId, userId])
  @@index([guildId, chatPoints, manualPoints])
}

model AltaMovChatAdjustment {
  id        String   @id @default(cuid())
  guildId   String
  userId    String
  amount    Int
  reason    String
  actorId   String
  createdAt DateTime @default(now())

  @@index([guildId, userId, createdAt])
}

model AltaMovChatReport {
  id                 String   @id @default(cuid())
  guildId            String
  cycleStartedAt     DateTime
  cycleEndedAt       DateTime
  trigger            String
  triggeredBy        String?
  reportGuildId      String
  reportChannelId    String
  status             String   @default("PENDING")
  entriesJson        String
  messageIdsJson     String   @default("[]")
  participantCount   Int
  totalMessages      Int
  totalScoredMessages Int
  totalPoints        Int
  createdAt          DateTime @default(now())

  @@index([guildId, cycleEndedAt])
}

model AltaMovChatCleanup {
  id                 String    @id @default(cuid())
  guildId            String
  channelId          String
  cutoffAt           DateTime
  scanBeforeId       String?
  status             String    @default("PENDING")
  deletedCount       Int       @default(0)
  skippedPinnedCount Int       @default(0)
  skippedOtherCount  Int       @default(0)
  lastError          String?
  nextAttemptAt      DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  completedAt        DateTime?
  items              AltaMovChatCleanupItem[]

  @@unique([guildId, channelId])
  @@index([guildId, status, nextAttemptAt])
}

model EventsSettings {
  guildId String @id
  channelsJson String @default("{}")
  managerRolesJson String @default("[]")
  functionsJson String @default("[]")
}

model EventsRecord {
  id String @id @default(cuid())
  guildId String
  kind String
  userId String
  key String? @unique
  body String
  status String @default("PENDING")
  reviewerId String?
  channelId String?
  messageId String?
  threadId String?
  startsAt DateTime?
  endsAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([guildId, kind, status])
}

model EventsAttendance {
  id String @id @default(cuid())
  guildId String
  eventId String
  userId String
  functionKey String
  functionName String
  points Int
  status String @default("PENDING")
  reviewerId String?
  messageId String?
  createdAt DateTime @default(now())
  @@unique([eventId, userId])
  @@index([guildId, userId, status])
}

model AltaMovChatCleanupItem {
  messageId String   @id
  cleanupId String
  createdAt DateTime
  cleanup   AltaMovChatCleanup @relation(fields: [cleanupId], references: [id], onDelete: Cascade)

  @@index([cleanupId, createdAt, messageId])
}
